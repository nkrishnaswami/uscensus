class WrappingCollector(Collector):
    child: Incomplete
    def __init__(self, child) -> None: ...
    @property
    def top_searcher(self): ...
    @property
    def context(self): ...
    def prepare(self, top_searcher, q, context) -> None: ...
    subsearcher: Incomplete
    matcher: Incomplete
    offset: Incomplete
    def set_subsearcher(self, subsearcher, offset) -> None: ...
    def all_ids(self): ...
    def count(self): ...
    def collect_matches(self) -> None: ...
    def sort_key(self, sub_docnum): ...
    def collect(self, sub_docnum): ...
    def remove(self, global_docnum): ...
    def matches(self): ...
    def finish(self) -> None: ...
    def results(self): ...

