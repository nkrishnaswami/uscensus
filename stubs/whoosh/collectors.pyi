def ilen(iterator): ...

class Collector(metaclass=abc.ABCMeta):
    top_searcher: Incomplete
    q: Incomplete
    context: Incomplete
    starttime: Incomplete
    runtime: Incomplete
    docset: Incomplete
    def prepare(self, top_searcher, q, context) -> None: ...
    def run(self) -> None: ...
    subsearcher: Incomplete
    offset: Incomplete
    matcher: Incomplete
    def set_subsearcher(self, subsearcher, offset) -> None: ...
    def computes_count(self): ...
    def all_ids(self): ...
    def count(self): ...
    def collect_matches(self) -> None: ...
    @abstractmethod
    def collect(self, sub_docnum): ...
    @abstractmethod
    def sort_key(self, sub_docnum): ...
    def remove(self, global_docnum) -> None: ...
    def matches(self): ...
    def finish(self) -> None: ...
    @abstractmethod
    def results(self): ...

class ScoredCollector(Collector, metaclass=abc.ABCMeta):
    replace: Incomplete
    def __init__(self, replace: int = 10) -> None: ...
    final_fn: Incomplete
    items: Incomplete
    minscore: int
    replaced_times: int
    skipped_times: int
    def prepare(self, top_searcher, q, context) -> None: ...
    def sort_key(self, sub_docnum): ...
    def collect(self, sub_docnum): ...
    matcher: Incomplete
    def matches(self) -> Generator[Incomplete]: ...

class TopCollector(ScoredCollector):
    limit: Incomplete
    usequality: Incomplete
    total: int
    def __init__(self, limit: int = 10, usequality: bool = True, **kwargs) -> None: ...
    def computes_count(self): ...
    def all_ids(self): ...
    def count(self): ...
    minscore: Incomplete
    def remove(self, global_docnum) -> None: ...
    def results(self): ...

class UnlimitedCollector(ScoredCollector):
    reverse: Incomplete
    def __init__(self, reverse: bool = False) -> None: ...
    def results(self): ...

