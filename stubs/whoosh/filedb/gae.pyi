class DatastoreFile(db.Model):
    value: Incomplete
    mtime: Incomplete
    data: Incomplete
    def __init__(self, *args, **kwargs) -> None: ...
    @classmethod
    def loadfile(cls, name): ...
    def close(self) -> None: ...
    def tell(self): ...
    def write(self, data): ...
    def read(self, length): ...
    def seek(self, *args): ...
