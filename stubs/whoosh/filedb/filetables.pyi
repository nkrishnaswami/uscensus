    def end_field(self) -> None: ...

class FieldedOrderedHashReader(HashReader):
    fieldmap: Incomplete
    fieldlist: Incomplete
    def __init__(self, *args, **kwargs) -> None: ...
    def field_start(self, fieldname): ...
