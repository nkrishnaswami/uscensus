    def term_get(self, fieldname, btext, default: Incomplete | None = None): ...
    def closest_term_pos(self, fieldname, key): ...
    def closest_term(self, fieldname, btext): ...
    def term_ranges_from(self, fieldname, btext) -> Generator[Incomplete]: ...
    def terms_from(self, fieldname, btext) -> Generator[Incomplete]: ...
