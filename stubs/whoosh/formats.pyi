from typing import Any, Callable, Iterable
from _typeshed import Incomplete
from collections.abc import Generator
from whoosh.analysis import Token, entoken as entoken, unstopped as unstopped
from whoosh.compat import b as b, dumps as dumps, iteritems as iteritems, loads as loads
from whoosh.system import emptybytes as emptybytes, pack_float as pack_float, pack_uint as pack_uint, unpack_float as unpack_float, unpack_uint as unpack_uint

class Format:
    posting_size: int
    textual: bool
    __inittypes__: dict[str, type]
    field_boost: float
    options: dict[str, Any]
    def __init__(self, field_boost: float = 1.0, **options) -> None: ...
    def __eq__(self, other: Any) -> bool: ...
    def fixed_value_size(self) -> int| None: ...
    def word_values(self, value: str, analyzer, **kwargs) -> Iterable[tuple[str, float, float, bytes]]: ...
    def supports(self, name: str) -> bool: ...
    def decoder(self, name: str) -> Callable: ...
    def decode_as(self, astype: str, valuestring: bytes) -> Any: ...

def tokens(value, analyzer, kwargs) -> Generator[Token, None, None]: ...

class Existence(Format):
    posting_size: int
    __inittypes__: Incomplete
    field_boost: Incomplete
    options: Incomplete
    def __init__(self, field_boost: float = 1.0, **options) -> None: ...
    def decode_frequency(self, valuestring: bytes) -> Any: ...
    def decode_weight(self, valuestring: bytes) -> Any: ...
    def combine(self, vs: Iterable[bytes]) -> bytes: ...

class Frequency(Format):
    posting_size: Incomplete
    __inittypes__: Incomplete
    field_boost: Incomplete
    options: Incomplete
    def __init__(self, field_boost: float = 1.0, boost_as_freq: bool = False, **options) -> None: ...
    def decode_frequency(self, valuestring: bytes) -> Any: ...
    def decode_weight(self, valuestring: bytes) -> Any: ...
    def combine(self, vs: Iterable[bytes]) -> bytes: ...

class Positions(Format):
    def encode(self, poslist) -> bytes: ...
    def decode_positions(self, valuestring: bytes) -> list[int]: ...
    def decode_position_boosts(self, valuestring: bytes) -> list[tuple[int, int]]: ...
    def combine(self, vs: Iterable[bytes]) -> bytes: ...

class Characters(Positions):
    def encode(self, poslist: list[int]) -> bytes: ...
    def decode_characters(self, valuestring: bytes) -> list[tuple[int, int, int]]: ...

class PositionBoosts(Positions):
    pass

class CharacterBoosts(Characters):
    def decode_character_boosts(self, valuestring): ...
