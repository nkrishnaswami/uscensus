from _typeshed import Incomplete
from collections.abc import Generator
from whoosh.compat import xrange as xrange
from whoosh.matching import mcore as mcore

class WrappingMatcher(mcore.Matcher):
    child: Incomplete
    boost: Incomplete
    def __init__(self, child, boost: float = 1.0) -> None: ...
    def copy(self): ...
    def depth(self): ...
    def replace(self, minquality: int = 0): ...
    def id(self): ...
    def all_ids(self): ...
    def is_active(self): ...
    def reset(self) -> None: ...
    def children(self): ...
    def supports(self, astype): ...
    def value(self): ...
    def value_as(self, astype): ...
    def spans(self): ...
    def skip_to(self, id): ...
    def next(self) -> None: ...
    def supports_block_quality(self): ...
    def skip_to_quality(self, minquality): ...
    def max_quality(self): ...
    def block_quality(self): ...
    def weight(self): ...
    def score(self): ...

class MultiMatcher(mcore.Matcher):
