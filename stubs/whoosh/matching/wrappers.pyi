    def __init__(self, matchers, idoffsets, scorer: Incomplete | None = None, current: int = 0) -> None: ...
    def is_active(self): ...
    def reset(self) -> None: ...
    def children(self): ...
    def copy(self): ...
    def depth(self): ...
    def replace(self, minquality: int = 0): ...
    def id(self): ...
    def all_ids(self) -> Generator[Incomplete]: ...
    def spans(self): ...
    def supports(self, astype): ...
    def value(self): ...
    def value_as(self, astype): ...
    def next(self) -> None: ...
    def skip_to(self, id): ...
    def supports_block_quality(self): ...
    def max_quality(self): ...
    def block_quality(self): ...
    def weight(self): ...
    def score(self): ...

def ExcludeMatcher(child, excluded, boost: float = 1.0): ...

